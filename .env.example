# =============================================================================
# Environment variables — copy to .env for local dev, or set in Coolify UI.
# (.env itself is gitignored and must never be committed.)
# =============================================================================

# ---- Server ----------------------------------------------------------------
# Port the app listens on. Coolify: set "Ports Exposes" to the same value.
PORT=5000

# MUST be "production" in Coolify so secure session cookies are enabled
# (works together with app.set('trust proxy', 1) behind Coolify's HTTPS proxy).
NODE_ENV=production

# Long random string for signing session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the deployed app (used in the Telegram "view report" link).
PUBLIC_URL=https://yukleme.example.com

# ---- SQLite database (persistent) ------------------------------------------
# Path to the SQLite file. In Coolify point this at a PERSISTENT VOLUME, e.g.
# a volume mounted at /app/data -> DB_PATH=/app/data/app.db
# Locally you can leave it unset (defaults to ./data/app.db).
DB_PATH=/app/data/app.db

# ---- Uploaded photos/videos (persistent) -----------------------------------
# Directory where uploaded media is stored. In Coolify point this at a SEPARATE
# persistent volume mounted at /app/uploads.
# Locally you can leave it unset (defaults to ./uploads).
UPLOADS_DIR=/app/uploads

# ---- Telegram notifications -------------------------------------------------
# Leave both empty to disable Telegram notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Voice fill (Gemini) ----------------------------------------------------
# Powers the loader's "fill report by voice" button. Leave GEMINI_API_KEY empty
# to disable the feature (the /api/voice-extract route returns 503).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name. gemini-2.0-flash is a stable, fast, widely-available default.
# Override if your key uses another (e.g. gemini-2.5-flash, gemini-1.5-flash).
GEMINI_MODEL=gemini-2.0-flash
# API style: 'generate' (DEFAULT, the classic and reliable :generateContent
# endpoint) or 'interactions' (the newer API — only if your key supports it;
# it can hang/timeout on keys that don't, so 'generate' is recommended).
GEMINI_API_STYLE=generate
# Max time (ms) to wait for Gemini before giving up with a clean error, so a
# slow/unreachable API never hangs the request. Default 25000 (25s).
GEMINI_TIMEOUT_MS=25000
# How many times to attempt a Gemini call. Transient failures (503 "model
# overloaded", 500, timeout) are retried with backoff; 429 (quota) is not.
GEMINI_RETRIES=3

# ---- Gemini-native VOICE (the bot reads questions + hears answers) ----------
# The bot speaks each question with a Gemini TTS voice and transcribes the
# loader's recorded answer with Gemini — no dependence on the device's voices.
# TTS model (preview). If your key has no access you'll see a clear error in the
# in-app voice log; then the question text is still shown so the flow continues.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS voice name (e.g. Kore, Puck, Charon, Aoede, Fenrir, Zephyr).
GEMINI_TTS_VOICE=Kore
# Model used to transcribe the recorded answer (audio understanding). Defaults to
# GEMINI_MODEL. gemini-2.0-flash / gemini-2.5-flash both accept audio.
GEMINI_STT_MODEL=gemini-2.0-flash
# The 16 questions are static, so their generated audio is cached on disk and
# reused forever (drastically fewer TTS API calls -> avoids free-tier 429 quota).
# Defaults to <UPLOADS_DIR>/tts-cache. Point at a persistent path in Coolify.
TTS_CACHE_DIR=/app/uploads/tts-cache

# ---- ONE-TIME data migration only (delete after migrating) -----------------
# Used ONLY by `node migrate/migrate.js` to read your existing data out of
# Supabase. NOT needed by the running app. Get the service_role key from:
#   Supabase dashboard -> Project Settings -> API -> "service_role" "secret".
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
