# =============================================================================
# Environment variables — copy to .env for local dev, or set in Coolify UI.
# (.env itself is gitignored and must never be committed.)
# =============================================================================

# ---- Server ----------------------------------------------------------------
# Port the app listens on. Coolify: set "Ports Exposes" to the same value.
PORT=5000

# MUST be "production" in Coolify so secure session cookies are enabled
# (works together with app.set('trust proxy', 1) behind Coolify's HTTPS proxy).
NODE_ENV=production

# Long random string for signing session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of the deployed app (used in the Telegram "view report" link).
PUBLIC_URL=https://yukleme.example.com

# ---- SQLite database (persistent) ------------------------------------------
# Path to the SQLite file. In Coolify point this at a PERSISTENT VOLUME, e.g.
# a volume mounted at /app/data -> DB_PATH=/app/data/app.db
# Locally you can leave it unset (defaults to ./data/app.db).
DB_PATH=/app/data/app.db

# ---- Uploaded photos/videos (persistent) -----------------------------------
# Directory where uploaded media is stored. In Coolify point this at a SEPARATE
# persistent volume mounted at /app/uploads.
# Locally you can leave it unset (defaults to ./uploads).
UPLOADS_DIR=/app/uploads

# ---- Telegram notifications -------------------------------------------------
# Leave both empty to disable Telegram notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- ONE-TIME data migration only (delete after migrating) -----------------
# Used ONLY by `node migrate/migrate.js` to read your existing data out of
# Supabase. NOT needed by the running app. Get the service_role key from:
#   Supabase dashboard -> Project Settings -> API -> "service_role" "secret".
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
